+def _clone_league_from_template(tpl: dict, players_dict: dict,
+                                seed_ratings: dict, opponents_ranked: bool):
+    """Build a (League, user_roster, seeded_opponent_ids) tuple for one cloned
+    template against the REAL universal pool. Opponent LeagueMembers carry the
+    consensus seed for their roster; `opponents_ranked` flips has_rankings True
+    on the first couple so mutual-match / likes-you flows are exercisable."""
+    members: list[LeagueMember] = []
+    seeded_ids: list[str] = []
+    seed_targets = set()
+    if opponents_ranked:
+        seed_targets = {o["user_id"] for o in tpl["opponents"][:2]}
+    for opp in tpl["opponents"]:
+        opp_ids = [str(x) for x in opp.get("player_ids", []) if str(x) in players_dict]
+        if not opp_ids:
+            continue
+        ranked = opp["user_id"] in seed_targets
+        members.append(LeagueMember(
+            user_id     = opp["user_id"],
+            username    = opp.get("username") or opp["user_id"],
+            roster      = opp_ids,
+            elo_ratings = {pid: seed_ratings.get(pid, 1500) for pid in opp_ids},
+            has_rankings= ranked,
+        ))
+        if ranked:
+            seeded_ids.append(opp["user_id"])
+    league = League(
+        league_id = tpl["template_id"],
+        name      = tpl["name"],
+        platform  = "sleeper",
+        members   = members,
+    )
+    user_roster = [pid for pid in tpl["operator_roster"] if pid in players_dict]
+    return league, user_roster, seeded_ids
+
