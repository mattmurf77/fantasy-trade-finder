+# realistic player pool + opponents. Logic in backend/test_templates.py.
+
+@app.route("/api/test-users/templates", methods=["POST"])
+def capture_test_templates():
+    """POST /api/test-users/templates — snapshot the caller's real leagues into
+    isolated qatest_ templates. The caller's real Sleeper user_id is resolved
+    from the session token; their leagues are read from the DB (populated by
+    their normal session_init syncs — no live Sleeper re-hit). Real rows are
+    READ-ONLY. Returns the list of captured templates."""
+    denied = _test_users_denied()
+    if denied is not None:
+        return denied
+    with _sessions_lock:
+        sess = _sessions.get(request.headers.get("X-Session-Token", ""))
+    user_id = sess.get("user_id") if sess else None
+    if not user_id:
+        return jsonify({"error": "no_session_user",
+                        "message": "Capture needs a session whose user_id is a "
+                                   "real Sleeper user with synced leagues."}), 400
+    try:
+        templates = _test_templates.capture_templates(user_id)
+        log.info("test-templates: captured %d for %s", len(templates), user_id)
+        return jsonify({"templates": templates, "captured": len(templates)})
+    except Exception as e:
+        log.error("test-templates capture failed: %s\n%s", e, traceback.format_exc())
+        return jsonify({"error": "internal_error"}), 500
+
+
+@app.route("/api/test-users/templates", methods=["GET"])
+def list_test_templates():
+    """GET /api/test-users/templates — list captured templates + qa_users_bound."""
+    denied = _test_users_denied()
+    if denied is not None:
+        return denied
+    try:
+        return jsonify({"templates": _test_templates.list_templates()})
+    except Exception as e:
+        log.error("test-templates list failed: %s\n%s", e, traceback.format_exc())
+        return jsonify({"error": "internal_error"}), 500
+
+
+@app.route("/api/test-users/templates/<template_id>", methods=["DELETE"])
+def delete_test_template_route(template_id: str):
+    """DELETE /api/test-users/templates/<id> — remove a template + every qa_*
+    user bound to it (their full row set) and evict their live sessions. Refuses
+    anything without the qatest_ prefix (never deletes a real league)."""
+    denied = _test_users_denied()
+    if denied is not None:
+        return denied
+    if not template_id.startswith(_test_templates.TEMPLATE_PREFIX):
+        return jsonify({"error": "not_a_template",
+                        "message": "Only qatest_* templates can be deleted here."}), 400
+    try:
+        counts = _test_templates.delete_template(template_id)
+        removed_users = counts.pop("_qa_user_ids", [])
+        # Evict live sessions for the template league or its bound qa_ users.
+        with _sessions_lock:
+            stale = [t for t, s in _sessions.items()
+                     if s.get("user_id") in removed_users
+                     or (s.get("league") is not None
+                         and getattr(s["league"], "league_id", None) == template_id)]
+            for t in stale:
+                _sessions.pop(t, None)
+        for uid in removed_users:
+            try:
+                delete_persisted_sessions_for_user(uid)
+            except Exception:
+                pass
+        counts["sessions_evicted"] = len(stale)
+        log.info("test-templates: deleted %s — %s", template_id, counts)
+        return jsonify({"ok": True, "template_id": template_id, "deleted": counts})
+    except Exception as e:
+        log.error("test-templates delete failed: %s\n%s", e, traceback.format_exc())
+        return jsonify({"error": "internal_error"}), 500
+
+
