+# ---------------------------------------------------------------------------
+# FB-174 — pinned-give package constraint ('all' vs 'any')
+# ---------------------------------------------------------------------------
+
+def _package_fixture():
+    """User rosters two mid WRs (uP1, uP2) the opponent covets, plus a
+    lineup-feasible base; the opponent holds a stud WR (oBig) the user
+    covets and a mid (oSmall). Eased waiver/surplus gates so BOTH single
+    1-for-1s (one pinned player) and 2-for-1 packages (both pinned) survive,
+    which is exactly what makes 'any' and 'all' diverge."""
+    ts._cfg["waiver_slot_cost"] = 0.0
+    ts._cfg["min_side_surplus"] = 20.0
+    pos = {**_bodies("u"), **_bodies("o"),
+           "uP1": "WR", "uP2": "WR", "oBig": "WR", "oSmall": "WR"}
+    players = _players_of(pos)
+    user_roster = list(_bodies("u")) + ["uP1", "uP2"]
+    opp_roster = list(_bodies("o")) + ["oBig", "oSmall"]
+
+    user_elo = {pid: 1500.0 for pid in pos}
+    opp_elo = {pid: 1500.0 for pid in pos}
+    for pid in _bodies("u"):
+        opp_elo[pid] = 1490.0
+    for pid in _bodies("o"):
+        user_elo[pid] = 1490.0
+    opp_elo.update({"uP1": 1600.0, "uP2": 1600.0})
+    user_elo.update({"oBig": 1660.0, "oSmall": 1560.0})
+    seed_elo = {pid: 1500.0 for pid in pos}
+    seed_elo.update({"uP1": 1540.0, "uP2": 1540.0,
+                     "oBig": 1600.0, "oSmall": 1545.0})
+    opponent = _member("opp", opp_roster, opp_elo)
+    return players, user_roster, opponent, user_elo, seed_elo
+
+
+def test_pinned_give_mode_all_requires_full_package():
+    """'all' — every suggestion's give side must contain the FULL pinned set;
+    single-pinned shapes that 'any' would surface are filtered out."""
+    players, user_roster, opponent, user_elo, seed_elo = _package_fixture()
+    cards = _v3(user_elo=user_elo, user_roster=user_roster, opponent=opponent,
+                seed_elo=seed_elo, players=players, fairness_threshold=0.5,
+                pinned_give_players=["uP1", "uP2"], pinned_give_mode="all")
+    assert cards, "'all' mode must still surface package cards"
+    for c in cards:
+        assert {"uP1", "uP2"} <= set(c.give_player_ids), (
+            "'all' mode: both pinned players must appear together on the give "
+            f"side, got {c.give_player_ids}")
+
+
+def test_pinned_give_mode_any_is_the_default_and_looser():
+    """'any' (default) keeps the shipped ≥1 semantics: at least one single-
+    pinned card exists that 'all' would reject, proving the modes diverge and
+    that omitting the mode is byte-identical to passing 'any'."""
+    players, user_roster, opponent, user_elo, seed_elo = _package_fixture()
+    default = _v3(user_elo=user_elo, user_roster=user_roster, opponent=opponent,
+                  seed_elo=seed_elo, players=players, fairness_threshold=0.5,
+                  pinned_give_players=["uP1", "uP2"])           # mode omitted
+    explicit_any = _v3(user_elo=user_elo, user_roster=user_roster,
+                       opponent=opponent, seed_elo=seed_elo, players=players,
+                       fairness_threshold=0.5,
+                       pinned_give_players=["uP1", "uP2"],
+                       pinned_give_mode="any")
+    key = lambda cs: sorted((frozenset(c.give_player_ids),
+                             frozenset(c.receive_player_ids)) for c in cs)
+    assert key(default) == key(explicit_any), (
+        "omitting pinned_give_mode must be identical to 'any'")
+    # Every pinned card includes ≥1 pin; at least one includes only ONE pin.
+    assert all(({"uP1", "uP2"} & set(c.give_player_ids)) for c in default)
+    assert any(not ({"uP1", "uP2"} <= set(c.give_player_ids)) for c in default), (
+        "'any' should surface at least one single-pinned card that 'all' drops")
+
+
+def test_pinned_give_mode_all_no_pins_is_parity():
+    """Guard: pinned_give_mode='all' with NO pins must be byte-identical to
+    unpinned generation — the mode only bites when pins are present."""
+    players, user_roster, opponent, user_elo, seed_elo = _package_fixture()
+    base = _v3(user_elo=user_elo, user_roster=user_roster, opponent=opponent,
+               seed_elo=seed_elo, players=players, fairness_threshold=0.5)
+    all_nopin = _v3(user_elo=user_elo, user_roster=user_roster,
+                    opponent=opponent, seed_elo=seed_elo, players=players,
+                    fairness_threshold=0.5, pinned_give_mode="all")
+    key = lambda cs: sorted((c.composite_score, frozenset(c.give_player_ids),
+                             frozenset(c.receive_player_ids)) for c in cs)
+    assert key(base) == key(all_nopin)
+
+
+def test_give_side_satisfies_pins_helper():
+    """The pure candidate-filter predicate FB-174 threads everywhere."""
+    from backend.trade_service import give_side_satisfies_pins as ok
+    pins = {"a", "b"}
+    # No pins ⇒ always True (unpinned generation unchanged).
+    assert ok(["x"], None, "all") is True
+    assert ok(["x"], set(), "any") is True
+    # 'any' ⇒ at least one pinned present.
+    assert ok(["a", "x"], pins, "any") is True
+    assert ok(["x", "y"], pins, "any") is False
+    # 'all' ⇒ the whole pinned set must be present (superset).
+    assert ok(["a", "b", "x"], pins, "all") is True
+    assert ok(["a", "x"], pins, "all") is False
+    # Unknown mode falls back to 'any'.
+    assert ok(["a", "x"], pins, "bogus") is True
+
+
+def test_pinned_give_mode_threads_through_generate_trades():
+    """End-to-end: pinned_give_mode='all' passed to the public generate_trades
