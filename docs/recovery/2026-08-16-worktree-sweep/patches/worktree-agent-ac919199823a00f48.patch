+    Returns the {give_value, receive_value, favors, gap} shape TradeValueBar
+    consumes, or None when either side can't be priced on consensus.
+
+    Presentation only — reuses _consensus_packages / _fairness_v3 /
+    _pick_gap_equivalent verbatim; invents no math and never touches engine
+    scoring."""
+    from .trade_optimizer import _consensus_packages, _fairness_v3
+    _players, seed = _get_universal_pool(scoring_format)
