{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/session_context.py\" --hook",
            "timeout": 10,
            "statusMessage": "Loading bounded session brief"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/session_context.py\" --stop-hook",
            "timeout": 10,
            "statusMessage": "Checking session memory limits"
          }
        ]
      }
    ]
  }
}
